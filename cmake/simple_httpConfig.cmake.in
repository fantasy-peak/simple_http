@PACKAGE_INIT@

# The exported target links zlib/brotli when compression was enabled at build
# time, so those imported targets must exist before it is included.
include(CMakeFindDependencyMacro)
if(@SIMPLE_HTTP_WITH_COMPRESSION@)
    find_dependency(ZLIB)
    find_dependency(Brotli)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/simple_httpTargets.cmake")
