  {
    "id": "basic.h2_version",
    "client": {"version": "h2"},
    "request": {"method": "GET", "path": "/version"},
    "expect": {"status": 200, "body_mode": "exact"}
  },
  {
    "id": "basic.h2_echo",
    "client": {"version": "h2"},
    "request": {"method": "POST", "path": "/echo", "body": {"kind": "text", "value": "over h2"}},
    "expect": {"status": 200, "body_mode": "json"}
  },
  {
    "id": "basic.h2c_echo",
    "client": {"version": "h2c"},
    "request": {"method": "GET", "path": "/echo"},
    "expect": {"status": 200, "body_mode": "json"}
  },
  {
    "id": "basic.h2c_upgrade",
    "mode": "cpp-only",
